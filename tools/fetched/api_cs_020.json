imedia.org/wikipedia/commons/0/02/3332_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto%2C_Nov_9_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:3332_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto,_Nov_9_2009.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=9065143","extmetadata":{"ImageDescription":{"value":"<a href=\"//commons.wikimedia.org/wiki/Digenes_Akritas\" class=\"mw-redirect\" title=\"Digenes Akritas\">Digenes Akritas</a> and the dragon. Byzantine dish, dating from the 12th century, unearthed in <a href=\"//commons.wikimedia.org/wiki/Athens\" title=\"Athens\">Athens</a>. On display in the <a href=\"//commons.wikimedia.org/wiki/Ancient_Agora_Museum_in_Athens\" class=\"mw-redirect\" title=\"Ancient Agora Museum in Athens\">Ancient Agora Museum in Athens</a>, housed in the <a href=\"//commons.wikimedia.org/wiki/Stoa_of_Attalus\" title=\"Stoa of Attalus\">Stoa of Attalus</a>. Picture by <a href=\"//commons.wikimedia.org/wiki/User:G.dallorto\" title=\"User:G.dallorto\">Giovanni Dall'Orto</a>, November 9 2009.","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:G.dallorto\" title=\"User:G.dallorto\">Giovanni Dall'Orto</a>.","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"9064120":{"pageid":9064120,"ns":6,"title":"File:3335 - Athens - Sto\u00e0 of Attalus Museum - Byzantine plate - Photo by Giovanni Dall'Orto, Nov 9 2009.jpg","index":5,"imagerepository":"local","imageinfo":[{"size":821817,"width":1972,"height":1796,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7d/3335_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto%2C_Nov_9_2009.jpg/960px-3335_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto%2C_Nov_9_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":583,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7d/3335_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto%2C_Nov_9_2009.jpg/1280px-3335_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto%2C_Nov_9_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7d/3335_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto%2C_Nov_9_2009.jpg/960px-3335_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto%2C_Nov_9_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":583,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7d/3335_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto%2C_Nov_9_2009.jpg/1280px-3335_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto%2C_Nov_9_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/7/7d/3335_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto%2C_Nov_9_2009.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:3335_-_Athens_-_Sto%C3%A0_of_Attalus_Museum_-_Byzantine_plate_-_Photo_by_Giovanni_Dall%27Orto,_Nov_9_2009.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=9064120","extmetadata":{"ImageDescription":{"value":"Basil Akritas (main character of the saga <i><a href=\"//commons.wikimedia.org/wiki/Digenes_Akritas\" class=\"mw-redirect\" title=\"Digenes Akritas\">Digenes Akritas</a></i>) and the dragon. Byzantine dish, dating from the 12th century, unearthed in <a href=\"//commons.wikimedia.org/wiki/Athens\" title=\"Athens\">Athens</a>. On display in the <a href=\"//commons.wikimedia.org/wiki/Ancient_Agora_Museum_in_Athens\" class=\"mw-redirect\" title=\"Ancient Agora Museum in Athens\">Ancient Agora Museum in Athens</a>, housed in the <a href=\"//commons.wikimedia.org/wiki/Stoa_of_Attalus\" title=\"Stoa of Attalus\">Stoa of Attalus</a>. Picture by <a href=\"//commons.wikimedia.org/wiki/User:G.dallorto\" title=\"User:G.dallorto\">Giovanni Dall'Orto</a>, November 9 2009.","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:G.dallorto\" title=\"User:G.dallorto\">Giovanni Dall'Orto</a>.","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},"45894674":{"pageid":45894674,"ns":6,"title":"File:Aphrodite's Rock, the site of the birth of the goddess Aphrodite, Cyprus (21955301454).jpg","index":9,"imagerepository":"local","imageinfo":[{"size":8613738,"width":4854,"height":3215,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/70/Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2821955301454%29.jpg/960px-Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2821955301454%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":424,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/70/Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2821955301454%29.jpg/1280px-Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2821955301454%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/70/Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2821955301454%29.jpg/960px-Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2821955301454%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":424,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/70/Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2821955301454%29.jpg/1280px-Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2821955301454%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/7/70/Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2821955301454%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Aphrodite%27s_Rock,_the_site_of_the_birth_of_the_goddess_Aphrodite,_Cyprus_(21955301454).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=45894674","extmetadata":{"ImageDescription":{"value":"<p>According to one legend, this rock is the site of the birth of the goddess Aphrodite, perhaps owing to the foaming waters around the rock fragments, and for this reason it is known as Aphrodite's Rock. Gaia (Mother Earth) asked one of her sons, Cronus, to mutilate his father, Uranus (Sky). Cronus cut off Uranus' testicles and threw them into the sea. Similar the local version indicates that Aphrodite\u2019s Rock is a part of the lower body of Cronus! This legend says that Cronus ambushed his father and cut him below the waist with a scythe. Uranus as he tried to escape flying, lost parts of his truncated body and testicles into the sea. A white foam appeared from which a maiden arose, the waves first taking her to Kythera and then bringing her to Cyprus. The maiden, named Aphrodite, went to the assembly of gods from Cyprus. The Romans widely referred to her as Venus. Aphrodite attracted a large cult following in Pafos, which was eventually crushed by the Romans. This is evident from the Sanctuary of Aphrodite in Old Pafos, Kouklia. A local myth is that any person who swims around the Aphrodite Rock will be blessed with eternal beauty.\n</p><p>Another legend associates the name Achni with the nearby beach, and attributes this to it being a site where the Achaeans came ashore on their return from Troy.\n</p><p>The present name Petra tou Romiou (Rock of the Greek) associates the place with the exploits of the hero Basil as told in the Digenes Akritas. Basil was half-Greek (Romios) and half-Arabic,[1] hence the name Digenes (two-blood). Legend tells that the Christian Basil hurled the huge rock from the Troodos Mountains to keep off the invading Saracens. A nearby rock is similarly known as the Saracen Rock.\n</p>\n<a class=\"external text\" href=\"https://en.wikipedia.org/wiki/Petra_tou_Romiou\">en.wikipedia.org/wiki/Petra_tou_Romiou</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/41523983@N08\">Carole Raddato</a> from FRANKFURT, Germany","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 2.0","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/2.0","source":"commons-desc-page"}},"mime":"image/jpeg"}]},"45894676":{"pageid":45894676,"ns":6,"title":"File:Aphrodite's Rock, the site of the birth of the goddess Aphrodite, Cyprus (22564499682).jpg","index":8,"imagerepository":"local","imageinfo":[{"size":10199858,"width":4817,"height":3202,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2822564499682%29.jpg/960px-Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2822564499682%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":425,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2822564499682%29.jpg/1280px-Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2822564499682%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2822564499682%29.jpg/960px-Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2822564499682%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":425,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2822564499682%29.jpg/1280px-Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2822564499682%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/a/a0/Aphrodite%27s_Rock%2C_the_site_of_the_birth_of_the_goddess_Aphrodite%2C_Cyprus_%2822564499682%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Aphrodite%27s_Rock,_the_site_of_the_birth_of_the_goddess_Aphrodite,_Cyprus_(22564499682).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=45894676","extmetadata":{"ImageDescription":{"value":"<p>According to one legend, this rock is the site of the birth of the goddess Aphrodite, perhaps owing to the foaming waters around the rock fragments, and for this reason it is known as Aphrodite's Rock. Gaia (Mother Earth) asked one of her sons, Cronus, to mutilate his father, Uranus (Sky). Cronus cut off Uranus' testicles and threw them into the sea. Similar the local version indicates that Aphrodite\u2019s Rock is a part of the lower body of Cronus! This legend says that Cronus ambushed his father and cut him below the waist with a scythe. Uranus as he tried to escape flying, lost parts of his truncated body and testicles into the sea. A white foam appeared from which a maiden arose, the waves first taking her to Kythera and then bringing her to Cyprus. The maiden, named Aphrodite, went to the assembly of gods from Cyprus. The Romans widely referred to her as Venus. Aphrodite attracted a large cult following in Pafos, which was eventually crushed by the Romans. This is evident from the Sanctuary of Aphrodite in Old Pafos, Kouklia. A local myth is that any person who swims around the Aphrodite Rock will be blessed with eternal beauty.\n</p><p>Another legend associates the name Achni with the nearby beach, and attributes this to it being a site where the Achaeans came ashore on their return from Troy.\n</p><p>The present name Petra tou Romiou (Rock of the Greek) associates the place with the exploits of the hero Basil as told in the Digenes Akritas. Basil was half-Greek (Romios) and half-Arabic,[1] hence the name Digenes (two-blood). Legend tells that the Christian Basil hurled the huge rock from the Troodos Mountains to keep off the invading Saracens. A nearby rock is similarly known as the Saracen Rock.\n</p>\n<a class=\"external text\" href=\"https://en.wikipedia.org/wiki/Petra_tou_Romiou\">en.wikipedia.org/wiki/Petra_tou_Romiou</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/41523983@N08\">Carole Raddato</a> from FRANKFURT, Germany","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 2.0","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/2.0","source":"commons-desc-page"}},"mime":"image/jpeg"}]},"16492778":{"pageid":16492778,"ns":6,"title":"File:Coppa, argento, dall'armenia cilicia, XII-XIII sec.JPG","index":7,"imagerepository":"local","imageinfo":[{"size":2734723,"width":1966,"height":1962,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Coppa%2C_argento%2C_dall%27armenia_cilicia%2C_XII-XIII_sec.JPG/960px-Coppa%2C_argento%2C_dall%27armenia_cilicia%2C_XII-XIII_sec.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":639,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Coppa%2C_argento%2C_dall%27armenia_cilicia%2C_XII-XIII_sec.JPG/1280px-Coppa%2C_argento%2C_dall%27armenia_cilicia%2C_XII-XIII_sec.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Coppa%2C_argento%2C_dall%27armenia_cilicia%2C_XII-XIII_sec.JPG/960px-Coppa%2C_argento%2C_dall%27armenia_cilicia%2C_XII-XIII_sec.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":639,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Coppa%2C_argento%2C_dall%27armenia_cilicia%2C_XII-XIII_sec.JPG/1280px-Coppa%2C_argento%2C_dall%27armenia_cilicia%2C_XII-XIII_sec.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/d/da/Coppa%2C_argento%2C_dall%27armenia_cilicia%2C_XII-XIII_sec.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Coppa,_argento,_dall%27armenia_cilicia,_XII-XIII_sec.JPG","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=16492778","extmetadata":{"ImageDescription":{"value":"<b>Vilgort Byzantine cup</b>\n<p>1150-1159 A.D., <a href=\"https://en.wikipedia.org/wiki/Armenian_Kingdom_of_Cilicia\" class=\"extiw\" title=\"w:Armenian Kingdom of Cilicia\">Armenian Kingdom of Cilicia</a>, or Turkey (1078-1375). Cup. Silver, gilding, black enamel. 12th-13th centuries. Provenance: received by the State Hermitage Museum, Saint Petersburg, Russia, in 1925. Discovered in 1925 in the village of Vilgort (East Urals).\n</p><p>Depicts Digenes Akritas and his wife Eydokia (alternatively spelled Eudocia in English-language translation), from the romance story <i><a href=\"//commons.wikimedia.org/wiki/Digenes_Akritas\" class=\"mw-redirect\" title=\"Digenes Akritas\">Digenes Akritas</a></i>.<sup id=\"cite_ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">[</span>1<span class=\"cite-bracket\">]</span></a></sup>  Detail from silver bowl, made in Cilician Armenia. In the image, Digenes is playing a <a href=\"https://en.wikipedia.org/wiki/Rotte_(psaltery)\" class=\"extiw\" title=\"w:Rotte (psaltery)\">rota</a>, triangular <a href=\"https://en.wikipedia.org/wiki/psaltery\" class=\"extiw\" title=\"w:psaltery\">psaltery</a>, sometimes mistaken for the <a href=\"https://en.wikipedia.org/wiki/harp\" class=\"extiw\" title=\"w:harp\">harp</a> today. This has also been interpreted as David with his wife<sup id=\"cite_ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">[</span>2<span class=\"cite-bracket\">]</span></a></sup>\n</p><p>A nearly identical work of art resides in the Museum of Historical Treasures of Ukraine .<sup id=\"cite_ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">[</span>3<span class=\"cite-bracket\">]</span></a></sup>\n</p>\nThe two works can be identified by their places of discovery, the <i>Vilgort Byzantine cup</i> and the <i>Chernihiv Byzantine cup</i>.","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Sailko\" title=\"User:Sailko\">sailko</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 3.0","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/3.0","source":"commons-desc-page"}},"mime":"image/jpeg"}]},"166744659":{"pageid":166744659,"ns":6,"title":"File:Digenes Akritas and his wife Eydokia, detail from silver cup, made in Cilician Armenia.jpg","index":1,"imagerepository":"local","imageinfo":[{"size":231841,"width":657,"height":643,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/2/2b/Digenes_Akritas_and_his_wife_Eydokia%2C_detail_from_silver_cup%2C_made_in_Cilician_Armenia.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":640,"thumbheight":626,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/2/2b/Digenes_Akritas_and_his_wife_Eydokia%2C_detail_from_silver_cup%2C_made_in_Cilician_Armenia.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":640,"height":626},"url":"https://upload.wikimedia.org/wikipedia/commons/2/2b/Digenes_Akritas_and_his_wife_Eydokia%2C_detail_from_silver_cup%2C_made_in_Cilician_Armenia.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Digenes_Akritas_and_his_wife_Eydokia,_detail_from_silver_cup,_made_in_Cilician_Armenia.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=166744659","extmetadata":{"ImageDescription":{"value":"<b>Vilgort Byzantine cup</b>\n<p>1150-1159 A.D., <a href=\"https://en.wikipedia.org/wiki/Armenian_Kingdom_of_Cilicia\" class=\"extiw\" title=\"w:Armenian Kingdom of Cilicia\">Armenian Kingdom of Cilicia</a>, or Turkey (1078-1375). Cup. Silver, gilding, black enamel. 12th-13th centuries. Provenance: received by the State Hermitage Museum, Saint Petersburg, Russia, in 1925. Discovered in 1925 in the village of Vilgort (East Urals).\n</p><p>Depicts Digenes Akritas and his wife Eydokia (alternatively spelled Eudocia in English-language translation), from the romance story <i><a href=\"//commons.wikimedia.org/wiki/Digenes_Akritas\" class=\"mw-redirect\" title=\"Digenes Akritas\">Digenes Akritas</a></i>.<sup id=\"cite_ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">[</span>1<span class=\"cite-bracket\">]</span></a></sup>  Detail from silver bowl, made in Cilician Armenia. In the image, Digenes is playing a <a href=\"https://en.wikipedia.org/wiki/Rotte_(psaltery)\" class=\"extiw\" title=\"w:Rotte (psaltery)\">rota</a>, triangular <a href=\"https://en.wikipedia.org/wiki/psaltery\" class=\"extiw\" title=\"w:psaltery\">psaltery</a>, sometimes mistaken for the <a href=\"https://en.wikipedia.org/wiki/harp\" class=\"extiw\" title=\"w:harp\">harp</a> today.\n</p><p>A nearly identical work of art (<b>Chernihiv Byzantine cup.</b>) resides in the Museum of Historical Treasures of Ukraine .<sup id=\"cite_ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">[</span>2<span class=\"cite-bracket\">]</span></a></sup><sup id=\"cite_ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">[</span>3<span class=\"cite-bracket\">]</span></a></sup>\n</p><p>The two works can be identified by their places of discovery, the <i>Vilgort Byzantine cup</i> and the <i>Chernihiv Byzantine cup</i>.\n</p>\nThis has also been interpreted as David with his wife<sup id=\"cite_ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">[</span>4<span class=\"cite-bracket\">]</span></a></sup>","source":"commons-desc-page"},"Artist":{"value":"Photo by <a href=\"//commons.wikimedia.org/wiki/User:Sailko\" title=\"User:Sailko\">sailko</a>","source":"commons-desc-page"},"LicenseSho